# ===== Tsayad HaDilim – environment variables =====
# Locally: copy to .env.  In production: add each as a GitHub Actions *Secret* (Settings → Secrets and variables → Actions).
# Never commit real values.

# --- AliExpress Affiliate (Open Platform) – docs/SETUP_ALIEXPRESS.md
AE_APP_KEY=
AE_APP_SECRET=
AE_TRACKING_ID=

# --- Telegram – docs/SETUP_TELEGRAM.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@tsayad_dilim
TELEGRAM_ADMIN_CHAT_ID=

# --- Encryption & dashboard (generate with: python -m tsayad keygen)
DATA_KEY=
DASHBOARD_PASSWORD=

# --- Click tracking worker (optional but needed for learning/A-B) – docs/SETUP_DEPLOY.md
TRACKER_URL=
TRACKER_SECRET=

# --- Free AI writer (optional) – Google AI Studio key, no credit card
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Facebook / Instagram (optional) – docs/SETUP_SOCIAL.md
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
GRAPH_API_VERSION=v26.0

# --- TikTok (optional, drafts) – docs/SETUP_SOCIAL.md
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Site (GitHub *Variables*, not secrets)
SITE_URL=https://tsayad-dilim.pages.dev
